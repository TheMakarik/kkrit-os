[Unit]
Description=KKRIT OS: Flatpak overrides
Documentation=https://github.com/TheMakarik/kkrit-os
After=flatpak-manager.service flatpak-preinstall.service
ConditionPathExists=/usr/bin/flatpak

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/kkrit-flatpak-overrides.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
